#!/bin/bash 
#PBS -l walltime=24:00:00 
#PBS -l mem=256GB 
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l jobfs=1024GB 
#PBS -l storage=gdata/dk92+gdata/rv74+gdata/ob53+scratch/er8
#PBS -l other=hyperthread 
#PBS -q gpuhopper
#PBS -P er8
