#!/bin/bash 
#PBS -l walltime=24:00:00 
#PBS -l mem=256GB 
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l jobfs=1024GB 
#PBS -l storage=gdata/dk92+gdata/rv74+gdata/ob53+scratch/er8
#PBS -l other=hyperthread 
#PBS -q gpuhopper
#PBS -P er8
#PBS -o /home/548/cd3022/repos/CPDiT/outputs/logs/train_dit.log
#PBS -j oe



# Set up directories
cd /home/548/cd3022/repos/CPDiT

# PBS Job Script for training CPDiT on HPC cluster
source hpc_setup.sh


# The model variant to train, e.g.
#   qsub -v INPUTS=configs/inputs/bands_b03_b07_b13.yaml scripts/train_dit.pbs
# Starts from that variant's latest stage-1 VAE and writes to
#   <runs_root>/<variant>/stage2_dit/<run_id>/
INPUTS="${INPUTS:?pass the variant: qsub -v INPUTS=configs/inputs/<variant>.yaml}"
INIT_FROM="${INIT_FROM:-stage1_vae}"

echo "Starting CPDiT DiT training for $INPUTS..."

torchrun --nproc_per_node=1 -m src.training.train \
    --config configs/train_base.yaml \
    --inputs "$INPUTS" \
    --init-from "$INIT_FROM"

echo "Training job completed!"