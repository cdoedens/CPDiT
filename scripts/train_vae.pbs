#!/bin/bash 
#PBS -l walltime=12:00:00 
#PBS -l mem=1024GB 
#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l jobfs=1024GB 
#PBS -l storage=gdata/dk92+gdata/rv74+gdata/ob53+scratch/er8
#PBS -l other=hyperthread 
#PBS -q gpuhopper
#PBS -P v46
#PBS -o /home/548/cd3022/repos/CPDiT/outputs/logs/train_vae.log
#PBS -j oe



# Set up directories
cd /home/548/cd3022/repos/CPDiT

# PBS Job Script for training CPDiT on HPC cluster
source hpc_setup.sh


# The model variant to train, e.g.
#   qsub -v INPUTS=configs/inputs/bands_b03_b07_b13.yaml scripts/train_vae.pbs
# Writes to <runs_root>/<variant>/stage1_vae/<run_id>/
INPUTS="${INPUTS:?pass the variant: qsub -v INPUTS=configs/inputs/<variant>.yaml}"

echo "Starting CPDiT VAE training for $INPUTS..."

# To resume a run in its own directory, append:
#   --resume <runs_root>/<variant>/stage1_vae/<run_id>/checkpoint_epoch_NNN.pt
torchrun --nproc_per_node=4 -m src.training.train \
    --config configs/train_vae_extension.yaml \
    --inputs "$INPUTS"

echo "Training job completed!"