#!/bin/bash 
#PBS -l walltime=24:00:00 
#PBS -l mem=96GB 
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l jobfs=256GB 
#PBS -l storage=gdata/dk92+gdata/rv74+gdata/ob53+scratch/er8
#PBS -l other=hyperthread 
#PBS -q gpuhopper
#PBS -P er8
#PBS -o /home/548/cd3022/repos/CPDiT/outputs/logs/inference.log
#PBS -j oe



# Set up directories
cd /home/548/cd3022/repos/CPDiT

# PBS Job Script for training CPDiT on HPC cluster
source hpc_setup.sh


echo "Starting CPDiT DiT inference..."



# The model to run, e.g. a variant's latest stage-2 weights:
#   qsub -v CHECKPOINT=/scratch/er8/cd3022/CPDiT/runs/<variant>/stage2_dit/latest/best_model.pt scripts/inference.pbs
# Forecasts are written to an inference/ folder beside the checkpoint.
CHECKPOINT="${CHECKPOINT:?pass the model: qsub -v CHECKPOINT=<best_model.pt>}"

python scripts/run_inference.py \
    --checkpoint "$CHECKPOINT" \
    --batch-size 4

echo "Inference job completed!"